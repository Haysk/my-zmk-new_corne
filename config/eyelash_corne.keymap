#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 60   // 10 -> 25 -> 60 : force de TOUT le scroll (milieu + molette)

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#include <locale/keys_fr.h>

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};


&lt {
    tapping-term-ms = <250>;
    flavor = "balanced";
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        // Positional home-row mods: the modifier only fires when a key on the
        // OPPOSITE hand (or a thumb) is pressed, killing same-hand misfires.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Left";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 45 46 47>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Right";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 42 43 44>;
            hold-trigger-on-release;
        };
    };

    macros {
        // AZERTY dead keys followed by space -> emit the literal symbol
        // (^, `, ~) instead of waiting to combine with the next vowel.
        sym_caret: sym_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp FR_CARET &kp SPACE>;
        };

        sym_grave: sym_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp FR_GRAVE &kp SPACE>;
        };

        sym_tilde: sym_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp FR_TILDE &kp SPACE>;
        };

        // Ctrl + molette = zoom universel (PyCharm, navigateur, images...).
        // Chaque cran : maintient Ctrl, envoie un cran de scroll, relâche Ctrl.
        // >>> RÉGLAGES :
        //   - ZMK_POINTING_DEFAULT_SCRL_VAL (haut du fichier) = force de TOUT
        //     le scroll (touches du milieu + zoom).
        //   - tap-ms ci-dessous = force du zoom SEULEMENT (par cran).
        //     Zoom trop lent -> monte tap-ms (60, 80). Saute trop -> baisse (25).
        zoom_in: zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LCTRL>
                     , <&macro_tap &msc SCRL_UP>
                     , <&macro_release &kp LCTRL>;
        };

        zoom_out: zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LCTRL>
                     , <&macro_tap &msc SCRL_DOWN>
                     , <&macro_release &kp LCTRL>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    zoom_encoder: zoom_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&zoom_in>, <&zoom_out>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <0 12 44 45>;
        };

        // Les deux pouces Shift ensemble -> Caps Word : tape une suite de
        // MAJUSCULES / CONSTANTES_SNAKE sans tenir Shift. Se coupe au premier
        // espace ou touche non-alphanumérique. Idéal pour le code.
        caps_word_combo {
            bindings = <&caps_word>;
            key-positions = <44 45>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Graphite";
            bindings = <
&kp BACKSPACE  &kp FR_B  &kp FR_L           &kp FR_D           &kp FR_W        &kp FR_Z                                        &msc SCRL_UP                     &kp FR_SQT      &kp FR_F        &kp FR_O           &kp FR_U           &kp FR_J      &kp DEL
&kp ESC        &kp FR_N  &hml LEFT_GUI FR_R  &hml LEFT_ALT FR_T  &hml LCTRL FR_S  &kp FR_G                     &msc SCRL_LEFT  &kp LC(FR_L)    &msc SCRL_RIGHT  &kp FR_Y        &hmr LCTRL FR_H  &hmr LEFT_ALT FR_A  &hmr LEFT_GUI FR_E  &kp FR_I  &kp FR_COLON
&kp K_APP      &kp FR_X  &kp FR_M           &kp FR_C           &kp FR_V        &kp FR_Q        &kp K_MUTE                   &msc SCRL_DOWN                   &kp FR_K        &kp FR_P        &kp FR_PERIOD      &kp FR_COMMA       &kp FR_SLASH  &kp FR_SEMICOLON
                                      &lt 4 TAB       &lt 1 SPACE  &kp LEFT_SHIFT                                                                &td0           &lt 2 ENTER  &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp FR_ASTERISK  &kp FR_N7               &kp FR_N8        &kp FR_N9           &kp FR_MINUS                         &kp LG(TAB)                      &trans     &kp LCTRL  &kp LEFT_ALT   &kp LEFT_GUI  &trans   &trans
&trans  &kp FR_N0        &hml LEFT_GUI FR_N4     &hml LEFT_ALT FR_N5  &hml LCTRL FR_N6  &kp FR_PLUS          &kp LG(LC(LEFT))  &kp LG(LC(D))   &kp LG(LC(RIGHT))  &trans     &kp LEFT   &kp DOWN       &kp UP        &kp RIGHT  &trans
&trans  &kp FR_PERIOD    &kp FR_N1               &kp FR_N2        &kp FR_N3           &kp FR_COMMA  &kp LA(LS(FR_N0))          &kp LG(D)                        &trans     &kp HOME   &kp PAGE_DOWN  &kp PG_UP     &kp END  &trans
                                              &trans           &trans              &trans                                                                &trans     &trans     &trans
            >;

            sensor-bindings = <&zoom_encoder>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &trans             &trans                            &kp FR_LEFT_BRACKET                &kp FR_RIGHT_BRACKET      &sym_caret                         &kp LG(UP)      &kp FR_DQT        &kp FR_ASTERISK     &kp FR_QUESTION             &kp FR_DOLLAR           &sym_grave          &trans
&trans  &kp FR_LEFT_BRACE  &hml LEFT_GUI FR_LEFT_PARENTHESIS  &hml LEFT_ALT FR_RIGHT_PARENTHESIS  &hml LCTRL FR_RIGHT_BRACE  &kp FR_PLUS                &kp LG(LEFT)  &kp LG(LS(S))  &kp LG(RIGHT)  &kp FR_AMPERSAND  &hmr LCTRL FR_MINUS  &hmr LEFT_ALT FR_UNDERSCORE  &hmr LEFT_GUI FR_EQUAL  &kp FR_EXCLAMATION  &trans
&trans  &trans             &trans                            &kp FR_LESS_THAN                   &kp FR_GREATER_THAN       &kp FR_AT_SIGN  &kp LG(FR_V)       &kp LG(DOWN)    &kp FR_PERCENT    &kp FR_PIPE         &kp FR_HASH                 &sym_tilde              &kp FR_BACKSLASH    &trans
                                                       &trans                          &trans                 &trans                                             &trans         &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(FR_Y) LC(FR_Z)>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &trans                            &rgb_ug RGB_ON               &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_TOG  &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &trans                &bt BT_PRV  &bt BT_CLR       &bt BT_NXT  &rgb_ug RGB_EFR  &kp LCTRL        &kp LEFT_ALT     &kp LEFT_GUI     &trans           &rgb_ug RGB_EFF
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &trans  &rgb_ug RGB_TOG           &rgb_ug RGB_OFF              &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &trans           &trans
                         &trans  &trans  &trans                                                         &trans           &trans           &trans
            >;

            sensor-bindings = <&rgb_encoder>;
        };

        layer_4 {
            display-name = "ACCENTS";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans          &kp LS(FR_CARET)  &trans          &kp FR_U_GRAVE  &trans            &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans          &kp FR_CARET    &kp FR_A_GRAVE  &kp FR_E_ACUTE  &kp FR_C_CEDILLA  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans          &trans          &trans          &trans          &kp FR_E_GRAVE  &trans          &trans
                        &trans  &trans  &trans                                    &trans       &trans       &trans
            >;
        };
    };
};
