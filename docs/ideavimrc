"" =============================================================================
""  .ideavimrc  —  PyCharm + IdeaVim
""  Optimisé pour clavier Corne (base Graphite, OS AZERTY/FR)
""  Navigation principale = flèches du layer NUMBER, souris réduite au maximum.
""  Doc IdeaVim : https://jb.gg/h38q75   Actions : https://jb.gg/abva4t
""  /!\ Vim n'autorise PAS de commentaire en fin de ligne `map`.
""      -> les commentaires des mappings sont toujours sur la ligne AU-DESSUS.
"" =============================================================================

"" --- Leader = Espace ---------------------------------------------------------
let mapleader = " "
"" 'space' ne doit plus avancer le curseur en normal (il devient leader)
nnoremap <Space> <Nop>
"" <leader><leader> = préfixe par défaut d'EasyMotion -> on le neutralise
"" pour qu'il n'écrive jamais de texte (libre à réaffecter plus tard).
nnoremap <leader><leader> <Nop>

"" =============================================================================
""  OPTIONS
"" =============================================================================
set scrolloff=8            " garde 8 lignes de contexte autour du curseur
set sidescrolloff=8
set incsearch             " recherche incrémentale
set hlsearch              " surligne les résultats
set ignorecase            " recherche insensible à la casse...
set smartcase             " ...sauf si la requête contient une majuscule
set showmode
set visualbell
set clipboard+=ideaput    " yank/paste via le presse-papier IDE
set clipboard+=unnamed    " yank/paste = presse-papier système

"" Intégration IDE
set ideajoin              " J = 'smart join' de PyCharm
set idearefactormode=keep " garde le mode Vim pendant un rename inline
set ideamarks             " marks Vim <-> bookmarks IDE synchronisés

"" =============================================================================
""  PLUGINS IdeaVim   (https://jb.gg/ideavim-plugins)
""  /!\ easymotion exige les plugins IDE "AceJump" + "IdeaVim-EasyMotion".
""      which-key  exige le plugin IDE "Which-Key" (éditeur TheBlob42).
"" =============================================================================
set highlightedyank       " flash sur le texte yanké
set commentary            " gcc / gc{motion}
set surround              " cs/ds/ys : entourer
set argtextobj            " text object argument : cia, dia, via
set textobj-entire        " ae / ie = tout le fichier
set NERDTree              " arbre projet au clavier
set which-key             " popup d'aide des mappings <leader>
set notimeout             " which-key : attend ta touche

"" easymotion : NE PAS laisser le plugin mapper <Leader> tout seul
"" (sinon il vole <leader>o, <leader>p... -> on garde nos mappings).
let g:EasyMotion_do_mapping = 0
set easymotion

"" =============================================================================
""  CONFORT D'ÉDITION
"" =============================================================================
"" Effacer le surlignage de recherche
nnoremap <leader>h :nohlsearch<CR>

"" Garder la sélection après indentation
vnoremap < <gv
vnoremap > >gv

"" Centrer l'écran après saut / recherche
nnoremap n nzzzv
nnoremap N Nzzzv
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

"" =============================================================================
""  1) SAUTER À L'ÉCRAN   (remplace le clic)
"" =============================================================================
"" <leader>s + 1 caractère -> labels sur les occurrences visibles
map <leader>s <Plug>(easymotion-s)
"" saut par ligne (haut / bas)
map <leader>l <Plug>(easymotion-bd-jk)

"" =============================================================================
""  2) FICHIERS / ONGLETS / RECHERCHE
"" =============================================================================
"" ouvrir un fichier par nom
map <leader>o <Action>(GotoFile)
"" rechercher dans tout le projet
map <leader>F <Action>(FindInPath)
"" fichiers récents (Switcher)
map <leader>e <Action>(RecentFiles)
"" emplacements récents
map <leader>E <Action>(RecentLocations)
"" Search Everywhere
map <leader>: <Action>(SearchEverywhere)
"" fermer l'onglet courant / tous (onglets : gt / gT natifs)
map <leader>q <Action>(CloseContent)
map <leader>Q <Action>(CloseAllEditors)
"" reculer / avancer dans l'historique du curseur
map <C-o> <Action>(Back)
map <C-i> <Action>(Forward)

"" =============================================================================
""  3) PANNEAUX D'OUTILS  (ouvrir / focus sans souris)
"" =============================================================================
"" arbre Projet / cibler le fichier courant
map <leader>p <Action>(ActivateProjectToolWindow)
map <leader>P <Action>(SelectInProjectView)
"" Terminal / Debug / Run
map <leader>tt <Action>(ActivateTerminalToolWindow)
map <leader>td <Action>(ActivateDebugToolWindow)
map <leader>tr <Action>(ActivateRunToolWindow)
"" Git / Problèmes / Résultats de recherche
map <leader>tg <Action>(ActivateVersionControlToolWindow)
map <leader>tp <Action>(ActivateProblemsViewToolWindow)
map <leader>tf <Action>(ActivateFindToolWindow)
"" masquer tous les panneaux (focus code)
map <leader>z <Action>(HideAllWindows)

"" =============================================================================
""  4) CODE : NAVIGATION / REFACTOR / QUICK-FIX
"" =============================================================================
"" déclaration / type / implémentation
map gd <Action>(GotoDeclaration)
map gy <Action>(GotoTypeDeclaration)
map gi <Action>(GotoImplementation)
"" usages (fenêtre / popup)
map gr <Action>(FindUsages)
map <leader>u <Action>(ShowUsages)
"" doc rapide
map gh <Action>(QuickJavaDoc)
"" erreur suivante / précédente
map ]e <Action>(GotoNextError)
map [e <Action>(GotoPreviousError)
"" méthode suivante / précédente
map ]m <Action>(MethodDown)
map [m <Action>(MethodUp)

"" quick-fix / intentions (ampoule)
map <leader>a <Action>(ShowIntentionActions)
"" renommer / reformater / ranger les imports
map <leader>cr <Action>(RenameElement)
map <leader>cf <Action>(ReformatCode)
map <leader>co <Action>(OptimizeImports)
"" menu Refactor / Generate / aperçu implémentation
map <leader>cm <Action>(Refactorings.QuickListPopupAction)
map <leader>cg <Action>(Generate)
map <leader>cd <Action>(QuickImplementations)

"" Run / Debug / breakpoint / stop
map <leader>rr <Action>(Run)
map <leader>rd <Action>(Debug)
map <leader>rc <Action>(RunClass)
map <leader>rb <Action>(ToggleLineBreakpoint)
map <leader>rs <Action>(Stop)

"" Bookmarks (navigation rapide)
map <leader>m <Action>(ToggleBookmark)
map <leader>M <Action>(ShowBookmarks)

"" NERDTree (arbre projet au clavier)
map <leader>n :NERDTreeToggle<CR>
map <leader>nf :NERDTreeFind<CR>

